# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# промежуточная сборка tsc для тестов (tools/run-tests.mjs)
/.tsc-tests/
# файловый кэш MangaDex (переживает недоступность источника)
/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# логи локального dev-сервера (next dev пишет их в корень)
dev.log
dev*.out
dev*.err

# env files (can opt-in for committing if needed)
.env*
# шаблон без секретов — в git нужен
!.env.example

# Ролики главной страницы: 195 МБ, в историю не идут.
# Инструкция по распаковке — public/video/README.md.
/public/video/*.mp4

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
