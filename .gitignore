# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# промежуточная сборка tsc для тестов (tools/run-tests.mjs)
/.tsc-tests/
# файловый кэш MangaDex (переживает недоступность источника)
/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...но шаблон с названиями переменных коммитим — по нему видно, что нужно заполнить
!.env.example

# база данных Prisma (SQLite) — создаётся миграциями, в историю не идёт
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
/dev.db
/dev.db-journal
/dev.db-wal
/dev.db-shm

# Ролики главной страницы: 195 МБ, в историю не идут.
# Инструкция по распаковке — public/video/README.md.
/public/video/*.mp4

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
