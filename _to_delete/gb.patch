+
+.gb-all b {
+  color: #fff;
+  font-variant-numeric: tabular-nums;
+}
+
+/* алтарь: пул света и тонкие кольца под веером — даёт сцене пол и глубину */
+.gb-altar {
+  position: absolute;
+  right: clamp(18px, 3.4vw, 64px);
+  bottom: 0;
+  width: var(--fan-w);
+  height: 62%;
+  z-index: 0;
+  pointer-events: none;
+}
+.gb-pool {
+  position: absolute;
+  inset: auto -8% -34% -8%;
+  height: 120%;
+  background: radial-gradient(ellipse 50% 50% at 50% 60%, rgba(120, 150, 255, 0.55), rgba(110, 90, 255, 0.18) 45%, transparent 70%);
+}
+.gb-ring {
+  position: absolute;
+  left: 6%;
+  right: 6%;
+  bottom: -26%;
+  height: 74%;
+  border-radius: 50%;
+  border: 1px solid rgba(170, 195, 255, 0.35);
+  box-shadow: 0 0 24px -4px rgba(110, 150, 255, 0.45), inset 0 0 30px -10px rgba(110, 150, 255, 0.4);
+  mask-image: linear-gradient(180deg, #000 0%, transparent 62%);
+  -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 62%);
+}
+.gb-ring-2 {
+  left: -6%;
+  right: -6%;
+  bottom: -42%;
+  height: 100%;
+  border-color: rgba(170, 195, 255, 0.16);
+  box-shadow: none;
+}
+
+/* центральная карта — единственный тёплый акцент композиции */
+.gb-card:nth-child(3) {
+  filter: drop-shadow(0 24px 26px rgba(0, 0, 0, 0.65)) drop-shadow(0 0 22px rgba(255, 80, 100, 0.32));
+}
+
+/* появление: карточки поднимаются по очереди (translate не конфликтует с transform при hover) */
+@keyframes gb-rise {
+  from {
+    opacity: 0;
+    translate: 0 46px;
+  }
+}
+@keyframes gb-fade {
+  from {
+    opacity: 0;
+    translate: -14px 0;
+  }
+}
+.gb-card {
+  animation: gb-rise 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
+}
+.gb-card:nth-child(1) { animation-delay: 0.25s; }
+.gb-card:nth-child(2) { animation-delay: 0.35s; }
+.gb-card:nth-child(4) { animation-delay: 0.45s; }
+.gb-card:nth-child(5) { animation-delay: 0.55s; }
+.gb-card:nth-child(3) { animation-delay: 0.7s; }
+.gb-left {
+  animation: gb-fade 0.8s ease-out both;
+}
+@media (max-width: 900px) {
+  .gb-altar {
+    right: auto;
+    left: 50%;
+    transform: translateX(-50%);
+    height: 48%;
+  }
+  .gb-crystal {
+    width: 84px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .gb-card,
+  .gb-left,
+  .gb-gem::before {
+    animation: none;
+  }
+}
+@media (max-width: 520px) {
+  .gb-eyebrow {
+    font-size: 11px;
+    letter-spacing: 0.06em;
+  }
+  .gb-dot {
+    display: none;
+  }
+}
