# Скопируйте этот файл в .env.local и подставьте свои значения.
# .env.local в git не попадает — ключи хранятся только на вашей машине и в настройках хостинга.

# Токен Kodik API (обязателен). Используется только на сервере.
KODIK_TOKEN=

# Домен API Kodik. kodikapi.com не резолвится, оставьте kodik-api.com.
KODIK_API_URL=https://kodik-api.com

# Приватный ключ подписи для прямых HLS-ссылок (необязателен, см. docs/sources-1080.md).
KODIK_PRIVATE_KEY=

# Зеркало Shikimori (необязательно): иначе пробуются shikimori.io, затем shikimori.one.
SHIKIMORI_API_URL=

# SQLite-база (аккаунты, прогресс, кланы, соцфункции). По умолчанию data/anigalaxy.db
# Нужен Node.js 22.13 или новее
DATABASE_PATH=./data/anigalaxy.db

# ИИ-ассистент «Нова» (Gemini). Без ключа раздел /assistant показывает «скоро».
GEMINI_API_KEY=
# Необязательно: модель и адрес API (если Gemini недоступен из вашего региона — свой прокси)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=
