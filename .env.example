# Шаблон окружения. Скопируй в `.env.local` и заполни под себя.
# Сам `.env.local` в git не попадает (см. .gitignore).

# --- База данных ---------------------------------------------------------
# Путь к файлу SQLite отсчитывается от корня проекта.
# При переезде на Postgres поменяй provider в prisma/schema.prisma и эту строку.
DATABASE_URL="file:./dev.db"

# --- Сессии --------------------------------------------------------------
# Случайная строка. Используется для подписи cookie и шифрования токенов сессий.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="замени-на-случайную-строку-минимум-32-символа"

# Сколько живёт сессия админа/пользователя, мс (по умолчанию 30 дней)
SESSION_TTL_MS="2592000000"

# --- Первый администратор ------------------------------------------------
# Логин и пароль, с которыми создаётся админ при `npm run db:seed`.
# После создания эти переменные можно удалить из .env.local.
ADMIN_SEED_NICKNAME="admin"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="смени-пароль-до-запуска-в-проде"

# --- Токены Kodik --------------------------------------------------------
# Внимание: в коде (`src/lib/kodik.ts`) есть токен по умолчанию, он попал
# в историю git. Обязательно переопредели здесь — иначе переполнится лимит
# запросов у всех, кто нальёт этот токен.
KODIK_TOKEN="укажи-свой-токен"
KODIK_API_URL="https://kodik-api.com"