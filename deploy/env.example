# Скопируйте в /opt/anigalaxy/.env.production и заполните. Файл НЕ коммитить с реальными значениями.

NEXT_PUBLIC_SITE_URL=https://example.com
# База данных: вне папки проекта, чтобы переживала обновления
DATABASE_PATH=/var/lib/anigalaxy/anigalaxy.db

# Kodik (только сервер)
KODIK_TOKEN=
KODIK_API_URL=
KODIK_PRIVATE_KEY=
KODIK_STREAM_TTL_HOURS=

# Telegram: вход через бота
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# webhook — Telegram сам шлёт сообщения на сайт (нужен HTTPS и домен); пусто — сервер опрашивает getUpdates
TELEGRAM_LOGIN_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
# Если сервер не достаёт до api.telegram.org, укажите адрес прокси-зеркала
TELEGRAM_API_BASE=

# Платежи (пока не подключены)
PAYMENTS_MODE=
PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=
